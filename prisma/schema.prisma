generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITORIA
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

model Usuario {
  id           String       @id @default(uuid()) @db.Uuid
  usuario      String       @unique
  hashSenha    String
  papel        PapelUsuario
  ativo        Boolean      @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  versao       Int          @default(1)

  @@map("usuarios")
}

model Organizacao {
  parceiros         Parceiro[]
  execucoes         ExecucaoAnalise[]
  id                String            @id @default(uuid()) @db.Uuid
  razaoSocial       String
  cnpj              String            @unique @db.Char(14)
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime          @default(now())
  ativo             Boolean           @default(true)
  versao            Int               @default(1)
  contrato          Contrato?
  lotes             Lote[]

  @@map("organizacoes")
}

model Contrato {
  id                  String      @id @default(uuid()) @db.Uuid
  organizacaoId       String      @unique @db.Uuid
  organizacao         Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  dataAssinatura      DateTime
  dataVencimento      DateTime
  clausulas           Json        @default("[]")
  valorMensal         Decimal     @db.Decimal(12, 2)
  renovacaoAutomatica Boolean     @default(true)
  versao              Int         @default(1)

  @@map("contratos")
}

model Lote {
  transicoes          TransicaoLote[]
  id                  String          @id @default(uuid()) @db.Uuid
  dataEntrada         DateTime
  organizacaoId       String          @db.Uuid
  organizacao         Organizacao     @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote      @default(RECEBIDO)
  observacoes         String          @default("")
  versao              Int             @default(1)
  equipamentos        Equipamento[]

  @@index([organizacaoId])
  @@index([dataEntrada])
  @@index([statusProcessamento])
  @@map("lotes")
}

model Equipamento {
  valorRecuperadoReal Decimal?           @db.Decimal(12, 2)
  valorRecuperadoEm   DateTime?
  previsoes           PrevisaoVidaUtil[]
  id                  String             @id @default(uuid()) @db.Uuid
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        Int
  pesoQuilogramas     Decimal            @db.Decimal(10, 3)
  loteId              String             @db.Uuid
  lote                Lote               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  posicaoNoLote       Int
  statusRastreamento  StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  versao              Int                @default(1)
  movimentacoes       Movimentacao[]

  @@unique([loteId, posicaoNoLote])
  @@index([loteId])
  @@index([statusRastreamento])
  @@map("equipamentos")
}

model Movimentacao {
  id            String      @id @default(uuid()) @db.Uuid
  equipamentoId String      @db.Uuid
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  dataHora      DateTime    @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String      @default("")
  versao        Int         @default(1)

  @@index([equipamentoId, dataHora])
  @@map("movimentacoes")
}

model JournalTransacao {
  id                 String   @id @default(uuid()) @db.Uuid
  timestamp          DateTime @default(now())
  operacao           String
  entidade           String
  entidadeId         String?
  dadosAntes         Json?
  dadosDepois        Json?
  usuarioResponsavel String
  versao             Int      @default(1)

  @@index([timestamp])
  @@index([entidade, entidadeId])
  @@map("journal_transacoes")
}

enum TipoAnalise {
  EFICIENCIA
  RENTABILIDADE
  VIDA_UTIL
}

enum OrigemExecucao {
  AGENDADA
  MANUAL
  API_PUBLICA
}

enum StatusExecucao {
  PENDENTE
  EM_PROCESSAMENTO
  CONCLUIDA
  FALHOU
}

enum DimensaoEficiencia {
  GERAL
  OPERADOR
  MES_ANO
  MES_DO_ANO
}

enum NivelRentabilidade {
  TIPO
  TIPO_ESTADO
  TIPO_MARCA
  TIPO_MARCA_MODELO
}

enum FonteValor {
  REALIZADO
  PARAMETRICO
  MISTO
}

enum ConfiancaModelo {
  ALTA
  MEDIA
  BAIXA
  INSUFICIENTE
}

enum FormatoRelatorio {
  CSV
  JSON
}

enum EscopoApi {
  RASTREABILIDADE_LER
  LOTES_LER
  LOTES_ESCREVER
  RELATORIOS_GERAR
}

model TransicaoLote {
  id             String      @id @default(uuid()) @db.Uuid
  loteId         String      @db.Uuid
  lote           Lote        @relation(fields: [loteId], references: [id], onDelete: Restrict)
  statusAnterior StatusLote?
  statusNovo     StatusLote
  usuario        String
  dataHora       DateTime    @default(now())
  versao         Int         @default(1)

  @@index([loteId, dataHora])
  @@index([statusNovo, dataHora])
  @@map("transicoes_lote")
}

model ParametroRecuperacao {
  id            String          @id @default(uuid()) @db.Uuid
  tipo          TipoEquipamento @unique
  valorBaseKg   Decimal         @db.Decimal(12, 4)
  fatoresEstado Json
  atualizadoEm  DateTime        @updatedAt
  versao        Int             @default(1)

  @@map("parametros_recuperacao")
}

model ExecucaoAnalise {
  id                    String                 @id @default(uuid()) @db.Uuid
  tipo                  TipoAnalise
  organizacaoId         String?                @db.Uuid
  organizacao           Organizacao?           @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  parametros            Json                   @default("{}")
  origem                OrigemExecucao
  status                StatusExecucao         @default(PENDENTE)
  solicitadoPor         String
  jobId                 String?
  tentativas            Int                    @default(0)
  erro                  String?
  versaoModelo          String
  resumo                Json?
  criadoEm              DateTime               @default(now())
  iniciadaEm            DateTime?
  concluidaEm           DateTime?
  duracaoMs             Int?
  versao                Int                    @default(1)
  metricasEficiencia    MetricaEficiencia[]
  metricasRentabilidade MetricaRentabilidade[]
  modelosVidaUtil       ModeloVidaUtil[]
  previsoes             PrevisaoVidaUtil[]
  tarefas               TarefaRelatorio[]

  @@index([tipo, organizacaoId, concluidaEm])
  @@index([status])
  @@map("execucoes_analise")
}

model MetricaEficiencia {
  id                String             @id @default(uuid()) @db.Uuid
  execucaoId        String             @db.Uuid
  execucao          ExecucaoAnalise    @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  dimensao          DimensaoEficiencia
  chave             String
  amostra           Int
  tempoMedioHoras   Decimal            @db.Decimal(12, 3)
  medianaHoras      Decimal            @db.Decimal(12, 3)
  desvioPadraoHoras Decimal            @db.Decimal(12, 3)
  p90Horas          Decimal            @db.Decimal(12, 3)
  esperaMediaHoras  Decimal            @db.Decimal(12, 3)
  triagemMediaHoras Decimal            @db.Decimal(12, 3)
  indiceSazonal     Decimal?           @db.Decimal(8, 4)
  gargalo           Boolean            @default(false)
  versao            Int                @default(1)

  @@unique([execucaoId, dimensao, chave])
  @@map("metricas_eficiencia")
}

model MetricaRentabilidade {
  id                 String             @id @default(uuid()) @db.Uuid
  execucaoId         String             @db.Uuid
  execucao           ExecucaoAnalise    @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  nivel              NivelRentabilidade
  chave              String
  tipo               TipoEquipamento
  estadoFisico       Int?
  marca              String?
  modelo             String?
  amostra            Int
  amostraRealizada   Int
  pesoTotalKg        Decimal            @db.Decimal(14, 3)
  valorMedioUnidade  Decimal            @db.Decimal(12, 2)
  valorMedioPorKg    Decimal            @db.Decimal(12, 4)
  valorTotalEstimado Decimal            @db.Decimal(14, 2)
  fonte              FonteValor
  ranking            Int?
  versao             Int                @default(1)

  @@unique([execucaoId, nivel, chave])
  @@index([execucaoId, nivel, tipo])
  @@map("metricas_rentabilidade")
}

model ModeloVidaUtil {
  id                  String             @id @default(uuid()) @db.Uuid
  execucaoId          String             @db.Uuid
  execucao            ExecucaoAnalise    @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  chave               String
  tipo                TipoEquipamento?
  origemModelo        String
  amostra             Int
  intercepto          Decimal            @db.Decimal(14, 6)
  inclinacao          Decimal            @db.Decimal(14, 6)
  r2                  Decimal            @db.Decimal(8, 6)
  erroPadraoResidual  Decimal            @db.Decimal(14, 6)
  taxaDanificados     Decimal            @db.Decimal(8, 4)
  idadeInservivelAnos Decimal?           @db.Decimal(8, 2)
  confianca           ConfiancaModelo
  versao              Int                @default(1)
  previsoes           PrevisaoVidaUtil[]

  @@unique([execucaoId, chave])
  @@map("modelos_vida_util")
}

model PrevisaoVidaUtil {
  id                     String          @id @default(uuid()) @db.Uuid
  execucaoId             String          @db.Uuid
  execucao               ExecucaoAnalise @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  modeloId               String          @db.Uuid
  modelo                 ModeloVidaUtil  @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  equipamentoId          String          @db.Uuid
  equipamento            Equipamento     @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  idadeAtualAnos         Int
  estadoFisicoAtual      Int
  vidaRemanescenteAnos   Decimal         @db.Decimal(8, 2)
  dataPrevistaInservivel DateTime
  geradoEm               DateTime        @default(now())
  realizadoEm            DateTime?
  erroDias               Int?
  avaliadaEm             DateTime?
  versao                 Int             @default(1)

  @@unique([execucaoId, equipamentoId])
  @@index([equipamentoId])
  @@index([avaliadaEm])
  @@map("previsoes_vida_util")
}

model Parceiro {
  id            String              @id @default(uuid()) @db.Uuid
  nome          String              @unique
  organizacaoId String              @db.Uuid
  organizacao   Organizacao         @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  contatoEmail  String
  ativo         Boolean             @default(true)
  criadoEm      DateTime            @default(now())
  versao        Int                 @default(1)
  chaves        ChaveApi[]
  tarefas       TarefaRelatorio[]
  idempotencias ChaveIdempotencia[]

  @@index([organizacaoId])
  @@map("parceiros")
}

model ChaveApi {
  id           String      @id @default(uuid()) @db.Uuid
  parceiroId   String      @db.Uuid
  parceiro     Parceiro    @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  prefixo      String      @unique @db.VarChar(16)
  hashChave    String      @db.Char(64)
  descricao    String
  escopos      EscopoApi[]
  limiteReqMin Int         @default(60)
  ativa        Boolean     @default(true)
  expiraEm     DateTime?
  revogadaEm   DateTime?
  ultimoUsoEm  DateTime?
  criadoEm     DateTime    @default(now())
  versao       Int         @default(1)

  @@index([parceiroId])
  @@map("chaves_api")
}

model ChaveIdempotencia {
  id             String   @id @default(uuid()) @db.Uuid
  parceiroId     String   @db.Uuid
  parceiro       Parceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)
  chave          String   @db.VarChar(64)
  hashCorpo      String   @db.Char(64)
  statusResposta Int      @default(0)
  corpoResposta  Json?
  criadoEm       DateTime @default(now())
  expiraEm       DateTime

  @@unique([parceiroId, chave])
  @@index([expiraEm])
  @@map("chaves_idempotencia")
}

model TarefaRelatorio {
  id            String           @id @default(uuid()) @db.Uuid
  tipo          TipoAnalise
  formato       FormatoRelatorio
  parceiroId    String?          @db.Uuid
  parceiro      Parceiro?        @relation(fields: [parceiroId], references: [id], onDelete: Restrict)
  organizacaoId String?          @db.Uuid
  solicitadoPor String
  parametros    Json             @default("{}")
  status        StatusExecucao   @default(PENDENTE)
  progresso     Int              @default(0)
  tentativas    Int              @default(0)
  erro          String?
  execucaoId    String?          @db.Uuid
  execucao      ExecucaoAnalise? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)
  nomeArquivo   String?
  tipoConteudo  String?
  tamanhoBytes  Int?
  conteudo      Bytes?
  jobId         String?
  criadoEm      DateTime         @default(now())
  iniciadaEm    DateTime?
  concluidaEm   DateTime?
  expiraEm      DateTime
  versao        Int              @default(1)

  @@index([parceiroId, status])
  @@index([status, criadoEm])
  @@index([expiraEm])
  @@map("tarefas_relatorio")
}
